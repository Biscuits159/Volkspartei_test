@convince_spd_dvp_candidate
view-if: spd_candidate != dvp_candidate and dvp_candidate = dvp_candidate
choose-if: braun_votes < (hitler_votes + harzburg_votes)
unavailable-subtitle: The Social Democrats are stronger than the far-right.
go-to: convince_spd_success_dvp_candidate if spd_relation >= 45; convince_spd_fail_dvp_candidate if not spd_relation >= 45
max-visits: 1

