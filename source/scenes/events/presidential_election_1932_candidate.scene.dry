@convince_spd_success_dvp_candidate
on-arrival: spd_relation += 3; spd_candidate = dvp_candidate; braun_campaign = 0 if braun_campaign; ddp_candidate = dvp_candidate if ddp_candidate = "Braun"; z_candidate = dvp_candidate if z_candidate = "Braun"; dbp_candidate = dvp_candidate if dbp_candidate = "Braun"
go-to: endorsements_dvp_candidate

